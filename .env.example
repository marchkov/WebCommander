# Configure users, a random secret, HTTPS and session-store policy before starting production.
HOST_ROOT_PATH=./data
WC_PORT=3001
WC_ROOT_PATH=/data/webcommander
WC_ALLOWED_PATHS=/data/webcommander
WC_BLOCKED_PATHS=/etc,/root,/var/log,/proc,/sys,/dev,/bin,/sbin,/usr,/lib
WC_AUTH_ENABLED=true
WC_AUTH_USERS=[]
WC_SESSION_SECRET=
WC_SESSION_MAX_AGE=86400000
WC_COOKIE_SECURE=true
WC_TRUST_PROXY=false
WC_SESSION_COOKIE_NAME=webcommander.sid
WC_ALLOW_MEMORY_SESSION_STORE=false
WC_CORS_ORIGINS=
WC_MAX_FILE_SIZE=104857600
WC_ALLOWED_EXTENSIONS=*
